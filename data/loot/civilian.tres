[gd_resource type="Resource" script_class="LootTable" format=3]

[ext_resource type="Script" path="res://scripts/data/loot_table.gd" id="1_loot_table"]
[ext_resource type="Script" path="res://scripts/data/loot_entry.gd" id="2_loot_entry"]
[ext_resource type="Resource" path="res://data/items/phone.tres" id="3_phone"]
[ext_resource type="Resource" path="res://data/items/wristwatch.tres" id="4_wristwatch"]
[ext_resource type="Resource" path="res://data/items/loyalty_card.tres" id="5_loyalty_card"]

[sub_resource type="Resource" id="Resource_phone"]
script = ExtResource("2_loot_entry")
item = ExtResource("3_phone")
chance = 0.6

[sub_resource type="Resource" id="Resource_wristwatch"]
script = ExtResource("2_loot_entry")
item = ExtResource("4_wristwatch")
chance = 0.15

[sub_resource type="Resource" id="Resource_loyalty_card"]
script = ExtResource("2_loot_entry")
item = ExtResource("5_loyalty_card")
chance = 0.4

[resource]
script = ExtResource("1_loot_table")
cash_min = 10
cash_max = 60
cash_chance = 0.9
entries = Array[ExtResource("2_loot_entry")]([SubResource("Resource_phone"), SubResource("Resource_wristwatch"), SubResource("Resource_loyalty_card")])
